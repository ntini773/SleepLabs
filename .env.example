# Public frontend variables — copy to .env.local for local development.
# Never add service-role, Resend, or cron secrets here; those belong in
# Supabase Edge Function secrets only (see supabase/README.md).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Base URL for audio files stored in Supabase Storage.
# Example (public bucket): https://your-project-ref.supabase.co/storage/v1/object/public/audio
# Upload condition-a.mp3 and condition-b.mp3 to the 'audio' bucket before going live.
NEXT_PUBLIC_AUDIO_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/audio
