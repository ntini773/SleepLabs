# Public frontend variables — copy to .env.local for local development.
# Never add service-role, Resend, or cron secrets here; those belong in
# Supabase Edge Function secrets only (see supabase/README.md).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Base URL for audio files stored in Supabase Storage.
# Example: https://your-project-ref.supabase.co/storage/v1/object/public/Audio_files
NEXT_PUBLIC_AUDIO_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/Audio_files

# Test-only. Leave EMPTY for the real study. Set to 1 only in a local test build to show the
# "Admin: Skip mandatory listening phase" button when the URL also has ?test=1.
NEXT_PUBLIC_ENABLE_TEST_MODE=
